<Layout>
  <div class="certifications-page">
    <section class="hero">
      <h1>Professional Certifications & Credentials</h1>
      <p class="subtitle">AI Data Engineering • Agentic AI & RAG • ML Pipelines • Language Proficiency</p>
    </section>

    {certifications.map((section) => (
      <section class="cert-section">
        <h2 class="section-title">{section.category}</h2>
        <div class="cert-gallery">
          {section.certs.map((cert) => (
            <a href={cert.pdf} target="_blank" rel="noopener noreferrer" class="cert-item">
              <img src={cert.image} alt={cert.title} class="cert-image" loading="lazy" />
              <div class="cert-info">
                <h3>{cert.title}</h3>
                <p class="org">{cert.org}</p>
                {cert.year && <p class="year">{cert.year}</p>}
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="cert-section">
      <h2 class="section-title">📋 Complete Coursera Credential Registry (48 Verified)</h2>
      <details class="registry-details">
        <summary class="registry-summary">
          View all 48 unique verified Coursera certificates (4 Specializations & 44 Courses) with Credential IDs & Verification URLs
        </summary>
        <div class="registry-table-wrap">
          <table class="registry-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Certificate Name</th>
                <th>Type</th>
                <th>Issuer</th>
                <th>Completion Date</th>
                <th>Credential ID</th>
                <th>Verify</th>
              </tr>
            </thead>
            <tbody>
              {courseraRegistry.map((row, idx) => (
                <tr>
                  <td>{idx + 1}</td>
                  <td class="cert-name-cell">{row.name}</td>
                  <td><span class={`type-badge ${row.type.toLowerCase()}`}>{row.type}</span></td>
                  <td>{row.issuer}</td>
                  <td>{row.date}</td>
                  <td><code>{row.code}</code></td>
                  <td><a href={row.url} target="_blank" rel="noopener noreferrer">Verify ↗</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </section>

    <section class="cert-section">
      <h2 class="section-title">🏆 Awards</h2>
      <div class="cert-gallery">
        <div class="cert-item award-item">
          <img src="/emba-video-contest-plaque.png" alt="Executive MBA Council 2012 Video Contest Silver" class="cert-image" loading="lazy" />
          <div class="cert-info">
            <h3>Video Contest Silver (Booth Video Award)</h3>
            <p class="org">Executive MBA Council</p>
            <p class="year">2012</p>
          </div>
        </div>
        <div class="cert-item award-item">
          <img src="/afs-certificate.png" alt="AFS exchange certificate of appreciation" class="cert-image" loading="lazy" />
          <div class="cert-info">
            <h3>AFS Scholarship — Certificate of Appreciation</h3>
            <p class="org">Yanagawa City Ryokai District Youth Development Association</p>
            <p class="year">1994</p>
          </div>
        </div>
      </div>
    </section>

    <section class="footer-note">
      <p>🎓 Continuous learning drives continuous growth. <a href="https://github.com/anix-lynch/Certification" target="_blank">View full certification repository & CSV export →</a></p>
    </section>
  </div>
</Layout>


<style>
  .certifications-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 4rem;
    padding: 2rem 0;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    font-size: 1.2rem;
    color: #666;
    margin: 0;
  }

  .cert-section {
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: 1.8rem;
    margin-bottom: 2rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #667eea;
    display: inline-block;
  }

  .cert-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
    align-items: start;
  }

  .cert-item {
    background: white;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    position: relative;
  }

  .cert-item:hover {
    border-color: #667eea;
    box-shadow: 0 16px 40px rgba(102, 126, 234, 0.25);
    transform: translateY(-8px);
  }

  .award-item {
    cursor: default;
  }

  .cert-image {
    width: 100%;
    height: 160px;
    object-fit: cover;
    object-position: top;
    display: block;
    background: #f5f5f5;
    margin-bottom: 0.5rem;
  }

  .cert-info {
    padding: 0 0.4rem 0.6rem 0.4rem;
    color: #1f2937;
  }

  .cert-info h3 {
    font-size: 0.8rem;
    margin: 0 0 0.2rem 0;
    font-weight: 600;
    color: #1f2937;
    line-height: 1.2;
  }

  .cert-info .org {
    font-size: 0.72rem;
    color: #666;
    margin: 0.2rem 0 0 0;
    line-height: 1.2;
  }

  .cert-info .year {
    font-size: 0.68rem;
    color: #999;
    margin-top: 0.2rem;
  }

  .registry-details {
    background: #ffffff;
    border: 2px solid #e5e7eb;
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }

  .registry-summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95rem;
    color: #1f2937;
    padding: 0.25rem 0;
  }

  .registry-table-wrap {
    overflow-x: auto;
    margin-top: 1rem;
  }

  .registry-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
    color: #1f2937;
  }

  .registry-table th,
  .registry-table td {
    padding: 0.55rem 0.65rem;
    border-bottom: 1px solid #e5e7eb;
    text-align: left;
    white-space: nowrap;
  }

  .registry-table td.cert-name-cell {
    white-space: normal;
    font-weight: 500;
  }

  .registry-table th {
    background: #f9fafb;
    font-weight: 600;
    color: #374151;
  }

  .registry-table a {
    color: #4f46e5;
    text-decoration: none;
    font-weight: 600;
  }

  .registry-table a:hover {
    text-decoration: underline;
  }

  .type-badge {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .type-badge.specialization {
    background: #eef2ff;
    color: #4338ca;
  }

  .type-badge.course {
    background: #f3f4f6;
    color: #374151;
  }

  .footer-note {
    text-align: center;
    margin-top: 4rem;
    padding: 2rem;
    background: #f9f9f9;
    border-radius: 12px;
    color: #666;
  }

  .footer-note a {
    color: #667eea;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .footer-note a:hover {
    color: #764ba2;
  }

  @media (max-width: 1024px) {
    .cert-gallery {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 1.8rem;
    }
    .subtitle {
      font-size: 1rem;
    }
    .section-title {
      font-size: 1.4rem;
    }
    .cert-gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }
</style>

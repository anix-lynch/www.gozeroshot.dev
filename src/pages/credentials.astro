---
import Layout from '../components/Layout.astro';
import credentials from '../data/credentials.json';

const { repository, flagshipIds, additionalFlagships, courseworkIds, coursera } = credentials;
const byId = new Map(coursera.map(entry => [entry.code, entry]));
const flagships = [...flagshipIds.map(id => byId.get(id)!), ...additionalFlagships];
const coursework = courseworkIds.map(id => byId.get(id)!);
const courseCount = coursera.filter(entry => entry.type === 'Course').length;
const groups = new Map<string, typeof coursera>();
for (const entry of coursera) {
  const issuer = entry.issuer === 'Google Cloud' ? 'Google' : entry.issuer;
  const group = groups.get(issuer) ?? [];
  group.push(entry);
  groups.set(issuer, group);
}

const pageUrl = 'https://www.gozeroshot.dev/credentials';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://www.gozeroshot.dev/#person',
      name: 'Anix Lynch',
      hasCredential: [...coursera, ...additionalFlagships].map(entry => ({
        '@type': 'EducationalOccupationalCredential',
        name: entry.name,
        credentialCategory: 'type' in entry
          ? (entry.type === 'Course' ? 'Course Certificate' : 'Professional Certificate')
          : 'Professional Certification',
        url: entry.url,
        identifier: entry.code,
        ...('expires' in entry ? { expires: entry.expires } : {}),
        recognizedBy: { '@type': 'Organization', name: entry.issuer },
      })),
    },
    {
      '@type': 'CollectionPage',
      '@id': pageUrl,
      name: 'Credentials — Anix Lynch',
      url: pageUrl,
      sameAs: repository,
      about: { '@id': 'https://www.gozeroshot.dev/#person' },
    },
  ],
};
---
<Layout title="Credentials — Anix Lynch" description="Six professional credentials and an issuer-linked Coursera record for AI, data engineering, analytics, and operations.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />
  <main class="credentials">
    <h1>Credentials</h1>
    <ul class="flagships" aria-label="Flagship credentials">
      {flagships.map(entry => (
        <li class="credential">
          <p class="issuer">{entry.issuer}</p>
          <h2>{entry.name}</h2>
          <div class="proof">
            <span>{'expires' in entry ? (entry.issuer === 'Scrum Alliance' ? 'Expired Aug 2014' : 'Valid through Apr 2027') : entry.date.slice(0, 4)}</span>
            <a href={entry.url} aria-label={`${'type' in entry ? 'Verify' : 'View certificate for'} ${entry.name}`}>
              {'type' in entry ? 'Verify' : 'View certificate'}
            </a>
          </div>
        </li>
      ))}
    </ul>
    <section class="coursework">
      <h2>DeepLearning.AI × AWS</h2>
      <p>3/4 Verified Coursework</p>
      <ul>
        {coursework.map(entry => <li><a href={entry.url}>{entry.name}</a></li>)}
      </ul>
    </section>
    <details>
      <summary>48 verified Coursera credentials</summary>
      <p>{courseCount} course certificates and {coursera.length - courseCount} professional certificates.</p>
      {[...groups].map(([issuer, entries]) => (
        <section class="issuer-group">
          <h2>{issuer} ({entries.length})</h2>
          <ul>
            {entries.map(entry => (
              <li><a href={entry.url}>{entry.name}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </details>
    <p class="archive"><a href={repository}>Credential archive on GitHub</a></p>
  </main>
</Layout>

<style>
  .credentials {
    --color-text-primary: #0f1923;
    --color-text-secondary: #4a6080;
    --color-card-bg: #fff;
    --color-border: #dde8f0;
    --color-accent-bg-solid: #eaf3fb;
    --color-border-focus: #8cb0d4;
    --radius-lg: 14px;
    width: min(100% - 2rem, 65rem);
    margin: 4.5rem auto 3rem;
    color: var(--color-text-primary);
  }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 1.5rem; }
  h2 { font-size: 1rem; line-height: 1.4; margin: 0; }
  .flagships { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; list-style: none; padding: 0; }
  .credential, .coursework, details {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem 1.125rem;
  }
  .credential { display: flex; flex-direction: column; gap: .5rem; }
  .issuer, .proof, .coursework p, details p { color: var(--color-text-secondary); font-size: .875rem; margin: 0; }
  .proof { margin-top: auto; padding-top: .5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem; }
  a { color: var(--color-text-secondary); overflow-wrap: anywhere; text-underline-offset: .18em; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--color-border-focus); outline-offset: 4px; }
  .proof a { background: var(--color-accent-bg-solid); padding: .35rem .65rem; border-radius: 999px; }
  .coursework, details { margin-top: 1rem; }
  .coursework p, details p { margin-top: .5rem; }
  .coursework ul { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; list-style: none; padding: 0; }
  summary { cursor: pointer; font-weight: 700; }
  .issuer-group { border-top: 1px solid var(--color-border); margin-top: 1rem; padding-top: 1rem; }
  .issuer-group ul { padding-left: 1.25rem; line-height: 1.8; }
  .archive { margin-top: 1rem; font-size: .875rem; }
  @media (max-width: 820px) { .flagships { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 540px) { .flagships { grid-template-columns: 1fr; } }
</style>
